DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=True
BUK_API_KEY=replace-with-your-buk-api-key
BUK_API_BASE=https://azerta.buk.cl/api/v1/chile
BUK_AUTH_HEADER=auth_token
BUK_AUTH_PREFIX=

# Gemini es el unico proveedor y responde el 100% de las preguntas: sin
# clave (o sin creditos), el bot avisa que no puede responder en vez de
# inventar o caer a una respuesta generica.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Seudonimiza los nombres de la nomina antes de mandarlos a Gemini (PII de
# terceros a un proveedor externo). Activado por defecto; False para volver
# a mandar nombres reales.
ASISTENTE_ANONIMIZAR=True

# --- Seguridad ---------------------------------------------------------------
# Autorizacion por rol (chat/autorizacion.py): gerencia ve todo, ejecutivo
# solo su misma familia de rol. Los roles se administran en /portal/.
AUTORIZACION_ACTIVA=True

# Limites de frecuencia. Formato "N/segundos".
RATE_LIMIT_ACTIVO=True
RATE_LIMIT_CHAT=20/60
RATE_LIMIT_CHAT_HORA=240/3600
RATE_LIMIT_FEEDBACK=30/60
RATE_LIMIT_PROPUESTAS=5/3600

# Anti prompt-injection sobre la consulta entrante (chat/antiprompt.py).
ANTIPROMPT_ACTIVO=True
ANTIPROMPT_UMBRAL=1

# Anti-abuso del modelo.
ASISTENTE_MAX_CARACTERES=2000
ASISTENTE_MAX_PEDIDOS_PASO=5
LLM_PRESUPUESTO_DIARIO=300

# Rate limit del login del admin (usuario/clave). Formato "N/segundos".
RATE_LIMIT_ADMIN_LOGIN=10/300

# --- HTTPS / cabeceras (solo aplican con DJANGO_DEBUG=False) ---------------
# Origenes de confianza para CSRF EN PRODUCCION, con scheme. Coma-separado.
#   DJANGO_CSRF_ORIGINS=https://iris.azerta.cl
DJANGO_CSRF_ORIGINS=
# Redirige HTTP -> HTTPS.
DJANGO_SSL_REDIRECT=True
# True si hay un proxy/balanceador que termina TLS delante (Cloud Run, nginx...).
DJANGO_BEHIND_TLS_PROXY=False
# HSTS: el navegador fuerza HTTPS por N segundos. Empeza chico (3600), confirma
# que todo anda sobre HTTPS y recien ahi subilo. 0 = desactivado.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# --- Documentos: local o Google Drive --------------------------------------
# local -> los archivos en datos/ (por defecto).
# drive -> una carpeta compartida de Google Drive, con una cuenta de servicio
#          de solo lectura (ver README, "Documentos internos").
# La planilla de cuentas con RUTs se sigue leyendo SIEMPRE de datos/ local.
DOCUMENTOS_FUENTE=local
# ID de la carpeta o su URL completa (https://drive.google.com/drive/folders/<ID>).
GOOGLE_DRIVE_FOLDER_ID=
# Ruta al JSON de la cuenta de servicio (scope drive.readonly). Comparti la
# carpeta con el email de esa cuenta. El archivo esta en .gitignore.
GOOGLE_DRIVE_CREDENTIALS=
DRIVE_SYNC_TTL=300
DRIVE_OMITIR_SOSPECHOSOS=True
DRIVE_DOC_ANTIPROMPT_UMBRAL=2

# Login con Google: la app entera pide sesión iniciada. Sin estas tres
# variables nadie puede entrar (ver README, sección "Login").
GOOGLE_WORKSPACE_DOMAIN=azerta.cl
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
